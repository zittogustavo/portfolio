---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import { LOOKS, profile } from '@/data/profile';
import { defaultLang, languages, langs, localePath, useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, e.g. `` for home. */
  path?: string;
  noindex?: boolean;
}

const { lang, title, description, path = '', noindex = false } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site!;
const canonical = new URL(localePath(lang, path), site).href;
const ogImage = new URL('/og.png', site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: t('hero.role'),
  email: `mailto:${profile.email}`,
  telephone: profile.phone.tel,
  url: new URL(localePath(defaultLang), site).href,
  image: new URL('/og.png', site).href,
  address: { '@type': 'PostalAddress', addressCountry: 'AR' },
  sameAs: profile.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={languages[lang].htmlLang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex &&
        langs.map((l) => (
          <link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(localePath(l, path), site).href} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLang, path), site).href} />}

    <!-- Theme + preloader decided before first paint: no flash, no layout shift. -->
    <script is:inline define:vars={{ looks: LOOKS }}>
      (() => {
        const d = document.documentElement;
        let theme, look, seen;
        try {
          theme = localStorage.getItem('theme');
          look = localStorage.getItem('look');
          seen = sessionStorage.getItem('pl');
        } catch {}
        d.dataset.theme = theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        d.dataset.look = looks.includes(look) ? look : looks[0];
        if (!seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('pl');
      })();
    </script>

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />

    <meta name="theme-color" content="#e9e7e3" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {
      langs
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>
    <slot name="before" />
    <slot />
  </body>
</html>
