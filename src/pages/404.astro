---
import Base from '@/layouts/Base.astro';
import { localePath, useTranslations } from '@/i18n/ui';

// Static hosts serve a single 404, so it speaks both languages.
const en = useTranslations('en');
const es = useTranslations('es');
---

<Base lang="en" title={`404 — ${en('404.title')}`} description={en('404.text')} path="404" noindex>
  <main id="main" class="not-found">
    <p class="mono muted">404</p>
    <h1>{en('404.text')}</h1>
    <p lang="es" class="muted">{es('404.text')}</p>
    <p class="links">
      <a href={localePath('en')} class="link">{en('404.back')}</a>
      <a href={localePath('es')} class="link" lang="es">{es('404.back')}</a>
    </p>
  </main>
</Base>

<style>
  .not-found {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    min-height: 100svh;
    padding: var(--gutter);
    text-align: center;
    box-shadow: var(--glow);
  }

  h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1rem;
  }
</style>
