---
import Arrow from './Arrow.astro';
import { profile } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="contact lazy-render" style="--intrinsic-height:640px" aria-labelledby="contact-title">
  <div class="container contact-inner">
    <header class="section-head">
      <p class="mono muted">(04)</p>
      <h2 id="contact-title" class="section-title">{t('contact.title')}</h2>
    </header>

    <div class="contact-body">
      <p class="lead reveal">{t('contact.lead')}</p>

      <div class="email-row reveal">
        <a class="email" href={`mailto:${profile.email}`}>
          {profile.email}
          <Arrow />
        </a>
        <button type="button" class="copy mono" data-email={profile.email} data-copied={t('contact.copied')}>
          <span aria-live="polite">{t('contact.copy')}</span>
        </button>
      </div>

      <a class="phone link" href={`tel:${profile.phone.tel}`}>{profile.phone.display}</a>

      <ul class="links">
        {
          profile.socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener me" class="link">
                {social.label}
                <span class="sr-only">({t('a11y.newTab')})</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={profile.cv} download="Gustavo-Zitto-CV.pdf" class="link">{t('contact.cv')}</a>
        </li>
      </ul>
    </div>
  </div>

  <footer class="footer container mono">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <a href="#top" class="link">{t('footer.top')} ↑</a>
  </footer>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('.copy');
  const label = button?.querySelector('span');
  if (button && label) {
    const initial = label.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
        label.textContent = button.dataset.copied ?? '';
        setTimeout(() => (label.textContent = initial), 2000);
      } catch {
        location.href = `mailto:${button.dataset.email}`;
      }
    });
  }
</script>

<style>
  /* Closing frame: same warm edge glow as the hero. */
  .contact {
    position: relative;
    box-shadow: var(--glow);
  }

  .contact-inner {
    padding-block: clamp(5rem, 11vw, 9rem) clamp(4rem, 8vw, 6rem);
  }

  .contact-body {
    display: grid;
    gap: 1.5rem;
  }

  .lead {
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.375rem, 3.2vw, 2.25rem);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }

  .email:hover {
    color: var(--accent-ink);
  }

  .email:hover :global(.arrow) {
    transform: translate(3px, -3px);
  }

  .copy {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .copy:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  .phone {
    justify-self: start;
    font-size: 1.0625rem;
    font-variant-numeric: tabular-nums;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .links a {
    display: inline-block;
    padding-block: 0.35rem;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.6875rem;
  }

  @media (min-width: 52rem) {
    .contact-body {
      margin-left: 12rem;
    }
  }
</style>
