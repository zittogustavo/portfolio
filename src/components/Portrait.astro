---
/**
 * Cut-out portrait with four interchangeable "looks", picked with the switcher in the hero:
 * split (backend | frontend), post-its, motion and dissolve. Every look is plain CSS on top of
 * the same image, except dissolve, which adds a small canvas of pixel particles.
 * The active look lives on <html data-look>, set before first paint by the inline head script.
 */
import { getImage } from 'astro:assets';
import cutoutSrc from '@/assets/portrait-cutout.png';
import originalSrc from '@/assets/portrait.jpg';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const cutout = await getImage({ src: cutoutSrc, format: 'webp', width: cutoutSrc.width, quality: 82 });
const original = await getImage({ src: originalSrc, format: 'webp', width: 800, quality: 76 });

// Post-its: the uncut photo, sliced into a slightly misaligned grid.
const GRID = 5;
const jitter = (i: number, k: number) => Math.sin(i * 12.9898 + k * 78.233) * 43758.5453 % 1;
const tiles = Array.from({ length: GRID * GRID }, (_, i) => ({
  x: (i % GRID) / (GRID - 1),
  y: Math.floor(i / GRID) / (GRID - 1),
  dx: (jitter(i, 1) * 6).toFixed(1),
  dy: (jitter(i, 2) * 6).toFixed(1),
  r: (jitter(i, 3) * 2.2).toFixed(2),
}));
const notes = (['note.1', 'note.2', 'note.3', 'note.4'] as const).map((key) => t(key));

const code = `const dev = {
  name: 'Gustavo',
  stack: ['TS', 'SQL', 'PHP'],
  coffee: Infinity,
};

SELECT * FROM ideas
WHERE status = 'shipped';

<Portfolio lang="es|en" />`;
---

<div class="portrait" style={`--cutout:url(${cutout.src});--original:url(${original.src})`}>
  <!-- The portrait itself comes first: it is the LCP image, and the first <img> with this URL sets
       the request's priority (the look layers below reuse it). -->
  <img
    class="photo"
    src={cutout.src}
    alt={t('hero.photoAlt')}
    width={cutout.attributes.width}
    height={cutout.attributes.height}
    fetchpriority="high"
    decoding="async"
  />

  <!-- split -->
  <pre class="look split-code mono" aria-hidden="true">{code}</pre>
  <span class="look split-label split-label--l" aria-hidden="true">&#123; backend &#125;</span>
  <span class="look split-label split-label--r" aria-hidden="true">&lt;frontend /&gt;</span>

  <!-- motion: ghosts trail behind the sharp portrait (z-index -1) -->
  <div class="look motion" aria-hidden="true">
    <span class="streaks"></span>
    <img class="ghost" src={cutout.src} alt="" width={cutout.attributes.width} height={cutout.attributes.height} />
    <img class="ghost" src={cutout.src} alt="" width={cutout.attributes.width} height={cutout.attributes.height} />
  </div>

  <!-- split: left half posterised, paint multiplied into its highlights -->
  <img class="look split-poster" src={cutout.src} alt="" width={cutout.attributes.width} height={cutout.attributes.height} aria-hidden="true" />
  <div class="look split-face" aria-hidden="true"></div>
  <span class="look split-line" aria-hidden="true"></span>

  <!-- post-its -->
  <div class="look notes" aria-hidden="true">
    <div class="tiles">
      {
        tiles.map((tile) => (
          <span
            class="tile"
            style={`--x:${tile.x * 100}%;--y:${tile.y * 100}%;--dx:${tile.dx}px;--dy:${tile.dy}px;--r:${tile.r}deg`}
          />
        ))
      }
    </div>
    {notes.map((note, i) => <span class={`note note--${i + 1}`}>{note}</span>)}
  </div>

  <!-- dissolve -->
  <canvas class="look dissolve" aria-hidden="true"></canvas>
</div>

<script>
  // Pixel particles peeling off the right side of the portrait (dissolve look only).
  const root = document.documentElement;
  const canvas = document.querySelector<HTMLCanvasElement>('.portrait .dissolve');
  const photo = document.querySelector<HTMLImageElement>('.portrait .photo');

  if (canvas && photo) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    type P = { x: number; y: number; vx: number; vy: number; life: number; max: number; size: number; shade: number; bird: boolean; warm: boolean };
    let seeds: { x: number; y: number; shade: number }[] = [];
    let particles: P[] = [];
    let raf = 0;
    let visible = true;
    let w = 0;
    let h = 0;
    let accent = '';
    let fg = '';

    const sample = () => {
      // Read the cut-out at low resolution; spawn only from opaque pixels in the dissolving band.
      const sw = 120;
      const sh = Math.round((sw * photo.naturalHeight) / photo.naturalWidth);
      const off = new OffscreenCanvas(sw, sh).getContext('2d')!;
      off.drawImage(photo, 0, 0, sw, sh);
      const data = off.getImageData(0, 0, sw, sh).data;
      seeds = [];
      for (let y = 0; y < sh; y++) {
        for (let x = Math.floor(sw * 0.48); x < sw * 0.8; x++) {
          const i = (y * sw + x) * 4;
          if (data[i + 3] > 200) seeds.push({ x: x / sw, y: y / sh, shade: data[i] });
        }
      }
    };

    const spawn = (p?: P): P => {
      const s = seeds[(Math.random() * seeds.length) | 0];
      const max = 110 + Math.random() * 180;
      const bird = Math.random() < 0.08;
      return Object.assign(p ?? ({} as P), {
        x: s.x * w,
        y: s.y * h,
        vx: (bird ? 1.1 : 0.3) + Math.random() * 1.2,
        vy: (bird ? -0.7 : -0.35) + Math.random() * 0.3,
        life: p ? 0 : Math.random() * max,
        max,
        size: bird ? 4 + Math.random() * 4 : 1.5 + Math.random() * 3,
        // Darken the photo's greys so they read against the light background.
        shade: Math.round(s.shade * 0.62),
        bird,
        warm: Math.random() < 0.12,
      });
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = photo.clientWidth;
      h = photo.clientHeight;
      canvas.width = Math.round(w * 1.7 * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const frame = () => {
      ctx.clearRect(0, 0, w * 1.7, h);
      for (const p of particles) {
        p.life++;
        p.x += p.vx;
        p.y += p.vy;
        p.vy -= 0.002;
        if (p.life > p.max) spawn(p);
        const k = 1 - p.life / p.max;
        ctx.globalAlpha = Math.max(0, k);
        if (p.bird) {
          // A tiny flapping "v".
          const flap = Math.sin(p.life * 0.35) * p.size * 0.45;
          ctx.strokeStyle = fg;
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.moveTo(p.x - p.size, p.y - flap);
          ctx.lineTo(p.x, p.y);
          ctx.lineTo(p.x + p.size, p.y - flap);
          ctx.stroke();
          continue;
        }
        ctx.fillStyle = p.warm ? accent : `rgb(${p.shade},${p.shade},${p.shade})`;
        ctx.fillRect(p.x, p.y, p.size, p.size);
      }
      ctx.globalAlpha = 1;
    };

    const loop = () => {
      frame();
      raf = requestAnimationFrame(loop);
    };

    const sync = () => {
      const active = root.dataset.look === 'dissolve';
      cancelAnimationFrame(raf);
      raf = 0;
      if (!active || !seeds.length) return;
      const style = getComputedStyle(root);
      accent = style.getPropertyValue('--accent');
      fg = style.getPropertyValue('--fg');
      resize();
      if (!particles.length) particles = Array.from({ length: 520 }, () => spawn());
      if (reduce.matches || !visible) frame();
      else loop();
    };

    const start = () => {
      sample();
      sync();
    };
    if (photo.complete && photo.naturalWidth) start();
    else photo.addEventListener('load', start, { once: true });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(canvas);
    addEventListener('lookchange', sync);
    addEventListener('themechange', sync);
    addEventListener('resize', () => root.dataset.look === 'dissolve' && resize());
  }
</script>

<style>
  .portrait {
    position: relative;
    isolation: isolate;
    aspect-ratio: 777 / 697;
    height: 100%;
    margin-inline: auto;
  }

  .photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    filter: grayscale(1) contrast(1.04);
    transition:
      filter 0.6s,
      opacity 0.4s;
  }

  .look {
    display: none;
  }

  /* ---------- split ---------- */
  :global(:root[data-look='split']) :is(.split-code, .split-label, .split-poster, .split-face, .split-line) {
    display: block;
  }

  .split-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    filter: grayscale(1) contrast(2.6) brightness(1.18);
    clip-path: inset(0 50% 0 0);
  }

  .split-face {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 16% 10% at 36% 38%, #ffbc95 60%, transparent 100%),
      radial-gradient(ellipse 12% 18% at 30% 56%, #7fb8b0 55%, transparent 100%),
      radial-gradient(ellipse 10% 7% at 42% 46%, #ff8a4c 55%, transparent 100%),
      radial-gradient(ellipse 22% 12% at 24% 84%, #e8d3a8 60%, transparent 100%),
      radial-gradient(ellipse 9% 6% at 40% 24%, #f2836f 50%, transparent 100%),
      radial-gradient(ellipse 14% 9% at 44% 70%, #ffbc95 55%, transparent 100%);
    mix-blend-mode: multiply;
    opacity: 0.9;
    mask: var(--cutout) bottom / contain no-repeat;
    clip-path: inset(0 50% 0 0);
  }

  .split-line {
    position: absolute;
    top: 6%;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(transparent, var(--accent) 20%, var(--accent));
  }

  .split-code {
    position: absolute;
    left: 77%;
    top: 50%;
    font-size: 0.625rem;
    line-height: 1.7;
    color: var(--muted);
    white-space: pre;
    text-transform: none;
    opacity: 0.85;
  }

  .split-label {
    position: absolute;
    top: 36%;
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .split-label--l {
    right: 76%;
  }

  .split-label--r {
    left: 77%;
  }

  /* ---------- motion ---------- */
  :global(:root[data-look='motion']) .motion {
    display: block;
  }

  :global(:root[data-look='motion']) .photo {
    filter: grayscale(1) contrast(1.25);
  }

  .motion {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .ghost {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    filter: grayscale(1) contrast(1.3) blur(9px);
    opacity: 0.4;
    animation: drift 2.2s ease-in-out infinite alternate;
  }

  .ghost + .ghost {
    opacity: 0.25;
    animation-duration: 3.4s;
    animation-direction: alternate-reverse;
  }

  .streaks {
    position: absolute;
    inset: 10% -60%;
    background:
      repeating-linear-gradient(180deg, transparent 0 9px, rgb(128 128 128 / 0.16) 9px 10px, transparent 10px 23px, rgb(128 128 128 / 0.1) 23px 25px);
    filter: blur(0.6px);
    mask: radial-gradient(closest-side, #000, transparent);
    animation: streak 1.4s linear infinite;
  }

  @keyframes drift {
    from {
      transform: translateX(-16%) scaleX(1.08);
    }
    to {
      transform: translateX(16%) scaleX(1.08);
    }
  }

  @keyframes streak {
    from {
      transform: translateX(-4%);
    }
    to {
      transform: translateX(4%);
    }
  }

  /* ---------- post-its ---------- */
  :global(:root[data-look='notes']) .notes {
    display: block;
  }

  :global(:root[data-look='notes']) .photo {
    opacity: 0;
  }

  .notes {
    position: absolute;
    inset: 0;
  }

  .tiles {
    position: absolute;
    bottom: 0;
    left: 50%;
    height: 100%;
    aspect-ratio: 1;
    translate: -50% 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
  }

  .tile {
    background: var(--original) var(--x) var(--y) / 500% 500%;
    filter: grayscale(1);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
    transform: translate(var(--dx), var(--dy)) rotate(var(--r));
  }

  .note {
    position: absolute;
    width: 6.5rem;
    padding: 0.75rem 0.7rem;
    background: #f3e7a6;
    color: #2a2720;
    font-size: 0.75rem;
    line-height: 1.3;
    box-shadow: 0 6px 14px -6px rgb(0 0 0 / 0.35);
  }

  .note--1 {
    top: 6%;
    right: -14%;
    rotate: 4deg;
  }

  .note--2 {
    top: 40%;
    left: -12%;
    rotate: -5deg;
  }

  .note--3 {
    bottom: 12%;
    right: -10%;
    rotate: -3deg;
    background: var(--accent-soft);
  }

  .note--4 {
    bottom: 4%;
    left: -6%;
    rotate: 3deg;
  }

  /* ---------- dissolve ---------- */
  :global(:root[data-look='dissolve']) .dissolve {
    display: block;
  }

  :global(:root[data-look='dissolve']) .photo {
    mask: linear-gradient(90deg, #000 44%, rgb(0 0 0 / 0.45) 58%, transparent 76%);
  }

  .dissolve {
    position: absolute;
    top: 0;
    left: 0;
    width: 170%;
    max-width: none;
    height: 100%;
    pointer-events: none;
  }

  @media (max-width: 52rem) {
    .split-label,
    .split-code {
      display: none !important;
    }

    .note {
      width: 5.5rem;
      font-size: 0.6875rem;
    }

    .note--1 {
      right: -4%;
    }

    .note--2 {
      left: -4%;
    }
  }
</style>
