---
import { Picture } from 'astro:assets';
import me from '@/assets/me.png';
import { about, languagesInUse, yearsOfExperience } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: `${yearsOfExperience()}+`, label: t('about.stat.years') },
  { value: String(languagesInUse.length), label: t('about.stat.languages') },
  { value: '3', label: t('about.stat.cities') },
];
---

<section id="about" class="section container lazy-render" style="--intrinsic-height:1200px" aria-labelledby="about-title">
  <div class="section-head">
    <h2 id="about-title" class="section-title reveal-x">{t('about.title')}</h2>
  </div>

  <div class="about">
    <figure class="about-photo reveal">
      <Picture
        src={me}
        alt={t('about.photoAlt')}
        widths={[320, 480, 720]}
        sizes="(min-width: 52rem) 28rem, 90vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="about-text">
      {about[lang].map((paragraph) => <p class="reveal">{paragraph}</p>)}

      <dl class="stats">
        {
          stats.map((stat) => (
            <div class="stat reveal">
              <dt class="mono muted">{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .about-photo {
    align-self: start;
    max-width: 28rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .about-photo :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: transform 1.2s var(--ease-out);
  }

  .about-photo:hover :global(img) {
    transform: scale(1.04);
  }

  .about-text {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
  }

  .about-text > p:first-child {
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .stat dt {
    font-size: 0.6875rem;
    line-height: 1.35;
  }

  .stat dd {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  @media (min-width: 52rem) {
    .about {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
</style>
