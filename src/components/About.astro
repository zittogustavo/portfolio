---
import { about, languagesInUse, places, yearsOfExperience } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: `${yearsOfExperience()}+`, label: t('about.stat.years') },
  { value: String(languagesInUse.length), label: t('about.stat.languages') },
  { value: String(places.length), label: t('about.stat.cities') },
];
---

<section id="about" class="section container lazy-render" style="--intrinsic-height:900px" aria-labelledby="about-title">
  <header class="section-head">
    <p class="mono muted">(03)</p>
    <h2 id="about-title" class="section-title">{t('about.title')}</h2>
  </header>

  <div class="about">
    <div class="about-text">
      {about[lang].map((paragraph) => <p class="reveal">{paragraph}</p>)}
    </div>

    <dl class="stats">
      {
        stats.map((stat) => (
          <div class="stat reveal">
            <dt class="mono muted">{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 3rem;
  }

  .about-text {
    display: grid;
    gap: 1.1rem;
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .about-text > p:first-child {
    color: var(--fg);
    font-size: clamp(1.1875rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .stat dt {
    font-size: 0.625rem;
    line-height: 1.4;
  }

  .stat dd {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  @media (min-width: 52rem) {
    .about {
      grid-template-columns: 12rem minmax(0, 1fr);
    }

    .about-text,
    .stats {
      grid-column: 2;
    }

    .stats {
      max-width: 40rem;
    }
  }
</style>
