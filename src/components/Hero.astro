---
import HeroMap from './HeroMap.astro';
import Portrait from './Portrait.astro';
import { LOOKS, profile, yearsOfExperience } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const looks = LOOKS.map((id) => ({ id, name: t(`look.${id}`) }));
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero-bg">
    <HeroMap lang={lang} />
  </div>

  <div class="hero-stage" style="--i:0">
    <Portrait lang={lang} />
  </div>

  <div class="hero-content container">
    <div class="hero-intro">
      <p class="mono muted" style="--i:1">{t('hero.role')}</p>
      <h1 id="hero-title" style="--i:2">{profile.name}</h1>
      <p class="intro-text" style="--i:3">{t('hero.intro', { years: yearsOfExperience() })}</p>
    </div>

    <ul class="hero-meta mono" style="--i:4">
      <li class="available"><span class="pulse" aria-hidden="true"></span>{t('hero.available')}</li>
      <li class="muted">{t('hero.based')}</li>
      <li class="muted">
        {t('hero.time')}{' '}<time class="clock" data-tz={profile.timeZone} data-lang={lang}>--:--</time>{' '}GMT-3
      </li>
    </ul>

    <button
      type="button"
      class="look-switch mono"
      style="--i:5"
      data-looks={JSON.stringify(looks)}
      data-label={t('look.next')}
    >
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M13.5 8A5.5 5.5 0 1 1 11.9 4.1M13.5 2v3h-3" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" />
      </svg>
      <span class="look-text">{t('look.label')} <span class="look-index">01</span>/0{looks.length} · <span class="look-name">{looks[0].name}</span></span>
      <span class="sr-only look-next"></span>
    </button>
  </div>
</section>

<script>
  const root = document.documentElement;

  const clock = document.querySelector<HTMLTimeElement>('.clock');
  if (clock) {
    const format = new Intl.DateTimeFormat(clock.dataset.lang, {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: clock.dataset.tz,
    });
    const update = () => {
      const now = new Date();
      clock.textContent = format.format(now);
      clock.dateTime = now.toISOString();
    };
    update();
    setInterval(update, 15_000);
  }

  // Look switcher: cycles the portrait treatments and remembers the choice.
  const button = document.querySelector<HTMLButtonElement>('.look-switch');
  if (button) {
    const looks: { id: string; name: string }[] = JSON.parse(button.dataset.looks ?? '[]');
    const index = button.querySelector('.look-index')!;
    const name = button.querySelector('.look-name')!;
    const nextLabel = button.querySelector('.look-next')!;
    let current = Math.max(0, looks.findIndex((l) => l.id === root.dataset.look));

    const render = () => {
      const look = looks[current];
      const next = looks[(current + 1) % looks.length];
      root.dataset.look = look.id;
      index.textContent = String(current + 1).padStart(2, '0');
      name.textContent = look.name;
      nextLabel.textContent = `. ${(button.dataset.label ?? '').replace('{name}', next.name)}`;
    };
    render();

    button.addEventListener('click', () => {
      current = (current + 1) % looks.length;
      try {
        localStorage.setItem('look', looks[current].id);
      } catch {}
      render();
      dispatchEvent(new Event('lookchange'));
    });
  }
</script>

<style>
  /* Mobile: everything in flow (words, a band for the map, portrait). Desktop: layered. */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: hidden;
  }

  /* Warm glow on the edges, over everything (like a lens). */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    box-shadow: var(--glow);
    pointer-events: none;
  }

  .hero-bg {
    order: 2;
    position: relative;
    z-index: -1;
    flex: none;
    height: 12.5rem;
  }

  .hero-stage {
    order: 3;
    position: relative;
    align-self: center;
    margin-top: auto;
    height: min(50svh, 25rem);
  }

  .hero-content {
    order: 1;
    z-index: 2;
    display: grid;
    padding-top: 5.25rem;
    pointer-events: none;
  }

  .hero-content > * {
    pointer-events: auto;
  }

  .hero-intro {
    display: grid;
    gap: 0.75rem;
    max-width: 24rem;
  }

  h1 {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .intro-text {
    color: var(--muted);
    max-width: 21rem;
  }

  .hero-meta {
    display: grid;
    gap: 0.3rem;
    margin-top: 1.25rem;
  }

  .hero-meta li:not(.available) {
    display: none;
  }

  .available {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .pulse {
    position: relative;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ok);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: pulse 2s var(--ease-out) infinite;
  }

  @keyframes pulse {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  .clock {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .look-switch {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(8px);
    transition: border-color 0.2s;
  }

  .look-switch:hover {
    border-color: var(--fg);
  }

  .look-switch svg {
    transition: transform 0.5s var(--ease-out);
  }

  .look-switch:hover svg {
    transform: rotate(180deg);
  }

  @media (min-width: 52rem) {
    /* Portrait to the right, words to the left, the map in between. */
    .hero {
      display: block;
      min-height: max(100svh, 38rem);
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      height: auto;
    }

    .hero-stage {
      position: absolute;
      bottom: 0;
      left: 66%;
      height: min(76svh, 44rem);
      translate: -50% 0;
    }

    .hero-content {
      position: relative;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto;
      column-gap: 2rem;
      min-height: max(100svh, 38rem);
      padding-top: 5.5rem;
      padding-bottom: 2rem;
    }

    .hero-intro {
      align-self: end;
      grid-row: 1;
    }

    .hero-meta {
      grid-row: 2;
      grid-column: 1;
      margin-top: 1.75rem;
    }

    .hero-meta li:not(.available) {
      display: list-item;
      list-style: none;
    }

    .look-switch {
      position: static;
      grid-row: 2;
      grid-column: 2;
      align-self: end;
    }
  }

  /* Entrance after the preloader: transform only, so everything is painted from the start. */
  .hero [style*='--i'] {
    transition: transform 1.1s var(--ease-out) calc(var(--i) * 70ms + 150ms);
  }

  :global(html.pl:not(.pl-out)) .hero [style*='--i'] {
    transform: translateY(1.5rem);
    transition: none;
  }

  :global(html.pl:not(.pl-out)) .hero .hero-stage {
    transform: translateY(6%) scale(0.97);
  }
</style>
