---
import Dev from './Dev.astro';
import { profile, yearsOfExperience } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="hero container" aria-labelledby="hero-title">
  <div class="hero-meta mono" style="--i:2">
    <p class="available"><span class="pulse" aria-hidden="true"></span>{t('hero.available')}</p>
    <p class="muted">{t('hero.based')}</p>
    <p class="muted">
      {t('hero.time')}{' '}<time class="clock" data-tz={profile.timeZone} data-lang={lang}>--:--</time>{' '}(GMT-3)
    </p>
  </div>

  <p class="hero-role mono" style="--i:3">{t('hero.role')}</p>

  <div class="hero-stage">
    <Dev class="hero-dev" />
  </div>

  <p class="hero-intro" style="--i:1">{t('hero.intro', { years: yearsOfExperience() })}</p>

  <a href="#work" class="hero-scroll mono" style="--i:2">
    {t('hero.scroll')}
    <svg viewBox="0 0 12 20" width="12" height="20" aria-hidden="true">
      <path d="M6 1v17m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.5" fill="none"></path>
    </svg>
  </a>

  <h1 id="hero-title" class="hero-name">
    <span style="--i:0">{profile.firstName}</span>
    <span style="--i:1">{profile.lastName}</span>
  </h1>
</section>

<script>
  const clock = document.querySelector<HTMLTimeElement>('.clock');
  if (clock) {
    const format = new Intl.DateTimeFormat(clock.dataset.lang, {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: clock.dataset.tz,
    });
    const update = () => {
      const now = new Date();
      clock.textContent = format.format(now);
      clock.dateTime = now.toISOString();
    };
    update();
    setInterval(update, 15_000);
  }

  // Pause the illustration when it scrolls out of view.
  const dev = document.querySelector('.hero-dev');
  if (dev) {
    new IntersectionObserver(([entry]) => dev.classList.toggle('paused', !entry.isIntersecting)).observe(dev);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template:
      'meta' auto
      'stage' 1fr
      'name' auto
      'intro' auto
      / 1fr;
    gap: 1.5rem;
    min-height: 100svh;
    padding-top: 6rem;
    padding-bottom: 2rem;
  }

  .hero-meta {
    grid-area: meta;
    display: grid;
    gap: 0.25rem;
  }

  .available {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ok);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: pulse 2s var(--ease-out) infinite;
  }

  @keyframes pulse {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  .clock {
    display: inline-block;
    min-width: 5ch;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .hero-role {
    display: none;
  }

  /* The illustration takes whatever height is left, so name and intro stay in the first screen. */
  .hero-stage {
    grid-area: stage;
    position: relative;
    min-height: clamp(15rem, 40svh, 24rem);
  }

  .hero .hero-stage :global(svg.hero-dev) {
    position: absolute;
    inset: 0;
    width: auto;
    max-width: 100%;
    height: 100%;
    margin: auto;
  }

  :global(.hero-dev.paused *) {
    animation-play-state: paused !important;
  }

  .hero-intro {
    grid-area: intro;
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.5;
  }

  .hero-scroll {
    display: none;
  }

  /* Sized from the measured glyph widths so the name always spans the container exactly. */
  .hero-name {
    grid-area: name;
    display: flex;
    flex-direction: column;
    font-size: calc((100vw - 2 * var(--gutter)) / 4.4);
    font-weight: 650;
    line-height: 0.82;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    margin-left: -0.04em;
  }

  .hero-name span {
    display: block;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template:
        'meta role' auto
        'stage stage' 1fr
        'intro scroll' auto
        'name name' auto
        / 1fr 1fr;
      row-gap: 1rem;
      padding-top: 7rem;
    }

    .hero-role {
      display: block;
      grid-area: role;
      justify-self: end;
      text-align: right;
    }

    .hero-stage {
      min-height: 14rem;
    }

    .hero-scroll {
      grid-area: scroll;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      justify-self: end;
      align-self: end;
    }

    .hero-scroll svg {
      animation: nudge 1.8s var(--ease-in-out) infinite;
    }

    .hero-name {
      flex-direction: row;
      justify-content: space-between;
      font-size: min((100vw - 2 * var(--gutter)) / 7.1, 12rem);
    }
  }

  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* Entrance after the preloader: transform only, so text is painted (and counted for LCP) from the start. */
  .hero [style*='--i'] {
    transition: transform 1s var(--ease-out) calc(var(--i) * 90ms + 250ms);
  }

  :global(html.pl:not(.pl-out)) .hero [style*='--i'] {
    transform: translateY(40%);
    transition: none;
  }

  :global(html.pl:not(.pl-out)) .hero-meta,
  :global(html.pl:not(.pl-out)) .hero-role,
  :global(html.pl:not(.pl-out)) .hero-intro,
  :global(html.pl:not(.pl-out)) .hero-scroll {
    transform: translateY(1.5rem);
  }

  /* While the preloader runs, the character is lifted above it (see Preloader.astro). */
  :global(html.pl) .hero-stage {
    z-index: 91;
  }

  :global(html.pl:not(.pl-ready)) .hero-stage {
    visibility: hidden;
    animation: show-late 0s 6s forwards;
  }

  @keyframes show-late {
    to {
      visibility: visible;
    }
  }
</style>
