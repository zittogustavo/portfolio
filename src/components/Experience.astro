---
import Arrow from './Arrow.astro';
import { languagesInUse, visibleExperience } from '@/data/profile';
import { formatMonth, localize, useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="section container lazy-render" style="--intrinsic-height:2400px" aria-labelledby="experience-title">
  <header class="section-head">
    <p class="mono muted">(01)</p>
    <h2 id="experience-title" class="section-title">{t('exp.title')}</h2>
  </header>

  <div class="languages">
    <p class="mono muted">{t('exp.languages')}</p>
    <ul class="chips">
      {languagesInUse.map((name) => <li class="chip">{name}</li>)}
    </ul>
  </div>

  <ol class="jobs">
    {
      visibleExperience.map((job) => {
        const company = localize(job.company, lang);
        return (
          <li class="job reveal">
            <div class="job-when mono">
              <p class:list={{ current: !job.end }}>
                <time datetime={job.start}>{formatMonth(job.start, lang)}</time>
                {' — '}
                {job.end ? <time datetime={job.end}>{formatMonth(job.end, lang)}</time> : t('exp.present')}
              </p>
              <p class="muted">{job.place[lang]}</p>
            </div>

            <div class="job-main">
              <h3 class="job-role">
                {job.role[lang]}
                <span class="muted">
                  {' · '}
                  {job.url ? (
                    <a href={job.url} target="_blank" rel="noopener" class="link">
                      {company}
                      <Arrow />
                      <span class="sr-only">({t('a11y.newTab')})</span>
                    </a>
                  ) : (
                    company
                  )}
                </span>
              </h3>
              <ul class="dash-list muted">
                {job.highlights[lang].map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              {job.tagsAreLanguages && <p class="mono muted">{t('exp.languages')}</p>}
              <ul class="chips">
                {job.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .languages {
    display: grid;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .jobs {
    border-top: 1px solid var(--line);
  }

  .job {
    display: grid;
    gap: 0.9rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--line);
  }

  .job-when {
    display: grid;
    gap: 0.2rem;
    align-content: start;
  }

  .current::before {
    content: '';
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.1em;
  }

  .job-main {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }

  .job-role {
    font-size: 1.125rem;
    letter-spacing: -0.015em;
  }

  .job-role a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (min-width: 52rem) {
    .languages {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: center;
    }

    .job {
      grid-template-columns: 12rem minmax(0, 1fr);
    }

    .job-when {
      padding-top: 0.2rem;
    }
  }
</style>
