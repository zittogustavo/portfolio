---
import { languages, localePath, useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';

const links = [
  { href: '#work', label: t('nav.work') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#about', label: t('nav.about') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="header">
  <div class="header-inner container">
    <a href={localePath(lang)} class="brand" aria-label={t('a11y.home')}>
      Gustavo Zitto<span class="brand-mark">©</span>
    </a>

    <nav class="nav-desktop" aria-label={t('a11y.mainNav')}>
      <ul>
        {links.map((link) => <li><a href={link.href} class="link">{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="controls">
      <a
        href={localePath(otherLang)}
        hreflang={languages[otherLang].htmlLang}
        lang={languages[otherLang].htmlLang}
        class="ctrl ctrl-lang mono"
      >
        {languages[otherLang].short}<span class="sr-only">, {t('a11y.lang')}</span>
      </a>
      <button
        type="button"
        class="ctrl ctrl-theme"
        id="theme-toggle"
        data-label-light={t('a11y.theme', { theme: t('a11y.theme.light') })}
        data-label-dark={t('a11y.theme', { theme: t('a11y.theme.dark') })}
        aria-label={t('a11y.theme', { theme: t('a11y.theme.dark') })}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <mask id="moon-mask">
            <rect width="24" height="24" fill="#fff"></rect>
            <circle class="moon-bite" cx="24" cy="4" r="9" fill="#000"></circle>
          </mask>
          <circle class="sun-core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#moon-mask)"></circle>
          <g class="sun-rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 1.5v2m0 17v2M1.5 12h2m17 0h2M4.6 4.6l1.4 1.4m12 12 1.4 1.4M4.6 19.4 6 18M18 6l1.4-1.4"></path>
          </g>
        </svg>
      </button>
      <a href="#contact" class="cta">
        <span class="cta-dot" aria-hidden="true"></span>{t('cta.talk')}
      </a>
      <button type="button" class="ctrl ctrl-menu" popovertarget="mobile-menu" aria-label={t('a11y.menu')}>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="nav-mobile" popover aria-label={t('a11y.mainNav')}>
    <button
      type="button"
      class="ctrl menu-close"
      popovertarget="mobile-menu"
      popovertargetaction="hide"
      aria-label={t('a11y.close')}
    >
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    <ul>
      {
        links.map((link, i) => (
          <li style={`--i:${i}`}>
            <a href={link.href}>
              <span class="mono muted">0{i + 1}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle') as HTMLButtonElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  // Same values as --bg; hardcoded so syncing never forces a style recalc.
  const themeColor: Record<string, string> = { light: '#f1f0ec', dark: '#0e0e0d' };

  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    toggle.setAttribute('aria-label', (dark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '');
    toggle.setAttribute('aria-pressed', String(dark));
    meta?.setAttribute('content', themeColor[root.dataset.theme ?? 'light']);
  };
  sync();

  const apply = (theme: string) => {
    root.dataset.theme = theme;
    sync();
  };

  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', next);
    } catch {}

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduce) return apply(next);

    const { left, top, width, height } = toggle.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    root.style.setProperty('--vt-x', `${x}px`);
    root.style.setProperty('--vt-y', `${y}px`);
    root.style.setProperty('--vt-r', `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`);
    document.startViewTransition(() => apply(next));
  });

  // Follow the OS while the visitor hasn't picked a theme.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (!stored) apply(e.matches ? 'dark' : 'light');
  });

  const menu = document.getElementById('mobile-menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) menu.hidePopover();
  });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
  }

  /* Solid from the start where scroll timelines aren't supported (zero-length animation). */
  .header {
    animation: header-solid linear both;
  }

  @supports (animation-timeline: scroll()) {
    .header {
      animation-timeline: scroll();
      animation-range: 0 12rem;
    }
  }

  @keyframes header-solid {
    to {
      background: color-mix(in srgb, var(--bg) 78%, transparent);
      backdrop-filter: blur(14px);
      border-color: var(--line);
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  .brand {
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-block;
    margin-left: 0.15em;
    font-size: 0.75em;
    vertical-align: super;
    transition: transform 0.6s var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: rotate(360deg);
  }

  .nav-desktop ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    font-size: 0.9375rem;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ctrl {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .ctrl:hover {
    border-color: var(--fg);
  }

  /* Sun ↔ moon morph */
  .sun-core {
    transition: r 0.5s var(--ease-out);
  }

  .moon-bite {
    transition:
      cx 0.5s var(--ease-out),
      cy 0.5s var(--ease-out);
  }

  .sun-rays {
    transform-origin: center;
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.3s;
  }

  :global([data-theme='dark']) .sun-core {
    r: 9px;
  }

  :global([data-theme='dark']) .moon-bite {
    cx: 17px;
    cy: 7px;
  }

  :global([data-theme='dark']) .sun-rays {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding-inline: 1.1rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    transition: transform 0.3s var(--ease-out);
  }

  .cta:hover {
    transform: scale(1.04);
  }

  .cta-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .ctrl-menu {
    display: none;
  }

  .ctrl-menu span,
  .ctrl-menu span::before {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: currentColor;
    box-shadow: 0 -4px 0 currentColor;
  }

  .ctrl-menu span::before {
    content: '';
    box-shadow: none;
    transform: translateY(4px);
  }

  /* Mobile menu: native popover, no JS framework needed */
  .nav-mobile {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 6rem var(--gutter) var(--gutter);
    border: 0;
    background: var(--bg);
    color: var(--fg);
    opacity: 0;
    transition:
      opacity 0.3s,
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }

  .nav-mobile:popover-open {
    opacity: 1;
  }

  @starting-style {
    .nav-mobile:popover-open {
      opacity: 0;
    }
  }

  .nav-mobile ul {
    display: grid;
    gap: 0.5rem;
  }

  .nav-mobile li {
    border-bottom: 1px solid var(--line);
    transition:
      transform 0.5s var(--ease-out) calc(var(--i) * 60ms),
      opacity 0.5s var(--ease-out) calc(var(--i) * 60ms);
  }

  @starting-style {
    .nav-mobile:popover-open li {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  .nav-mobile a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.75rem;
    font-size: clamp(2.25rem, 11vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 52rem) {
    .nav-desktop {
      display: none;
    }

    .ctrl-menu {
      display: grid;
    }
  }

  .menu-close {
    position: absolute;
    top: 0.75rem;
    right: var(--gutter);
  }

  @media (max-width: 30rem) {
    .cta {
      display: none;
    }
  }
</style>
