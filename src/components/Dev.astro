---
/**
 * Illustrated self-portrait: coding at a café table, sipping coffee.
 * Pure SVG + CSS animation, so it costs a few KB instead of a video.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['dev', className]}
  viewBox="0 0 400 410"
  width="400"
  height="410"
  aria-hidden="true"
  focusable="false"
>
  <ellipse cx="200" cy="392" rx="140" ry="9" fill="var(--dev-shadow)"></ellipse>

  <!-- Chair -->
  <rect x="136" y="176" width="128" height="96" rx="24" fill="var(--dev-furniture)"></rect>
  <rect x="132" y="282" width="136" height="10" rx="5" fill="var(--dev-furniture)"></rect>
  <path d="M158 290 146 390M242 290l12 100" stroke="var(--dev-furniture)" stroke-width="7" stroke-linecap="round"></path>

  <!-- Legs, swinging under the table -->
  <g class="dev-leg dev-leg--l">
    <rect x="160" y="262" width="24" height="90" rx="10" fill="#2f4363"></rect>
    <rect x="151" y="344" width="42" height="17" rx="8" fill="#fbfaf6"></rect>
    <rect x="149" y="357" width="46" height="5" rx="2.5" fill="var(--accent)"></rect>
  </g>
  <g class="dev-leg dev-leg--r">
    <rect x="216" y="262" width="24" height="90" rx="10" fill="#2f4363"></rect>
    <rect x="207" y="344" width="42" height="17" rx="8" fill="#fbfaf6"></rect>
    <rect x="205" y="357" width="46" height="5" rx="2.5" fill="var(--accent)"></rect>
  </g>

  <!-- Torso -->
  <path d="M146 214c0-22 14-32 36-34h36c22 2 36 12 36 34l3 60H143Z" fill="#8f959c"></path>
  <path d="M184 181q16 15 32 0" stroke="#7a8087" stroke-width="4" fill="none" stroke-linecap="round"></path>
  <path d="M187 158h26v23q-13 9-26 0Z" fill="#e3b08f"></path>

  <!-- Typing arm (hand hidden behind the laptop) -->
  <g class="dev-arm-type">
    <path d="M152 204c-18 10-20 36-10 48" stroke="#8f959c" stroke-width="22" stroke-linecap="round" fill="none"></path>
    <path d="M141 248c9 15 27 15 43 9" stroke="#f2c9a8" stroke-width="15" stroke-linecap="round" fill="none"></path>
  </g>

  <!-- Head -->
  <g class="dev-head">
    <ellipse cx="152" cy="132" rx="8" ry="12" fill="#e9b996"></ellipse>
    <ellipse cx="248" cy="132" rx="8" ry="12" fill="#e9b996"></ellipse>
    <ellipse cx="200" cy="128" rx="48" ry="52" fill="#f2c9a8"></ellipse>
    <path
      d="M153 124c-1 44 19 70 47 70s48-26 47-70c-5 16-15 25-25 25-8 6-16 7-22 7s-14-1-22-7c-10 0-20-9-25-25Z"
      fill="#6e6e6c"></path>
    <path d="M185 165q15 15 30 0Z" fill="#3b2b2a"></path>
    <path d="M188 166q12 6 24 0Z" fill="#fff"></path>
    <path
      d="M180 162c6-10 16-8 20-4 4-4 14-6 20 4-8-4-14-2-20 0-6-2-12-4-20 0Z"
      fill="#575755"></path>
    <path d="M199 127c-4 12-3 18 4 18" stroke="#d69d79" stroke-width="3" fill="none" stroke-linecap="round"></path>
    <g class="dev-eyes" fill="#1d1d1b">
      <ellipse cx="181" cy="123" rx="4.5" ry="5.5"></ellipse>
      <ellipse cx="219" cy="123" rx="4.5" ry="5.5"></ellipse>
    </g>
    <path d="M171 110q10-6 20-1m18 0q10-5 20 1" stroke="#4d4d4b" stroke-width="4.5" fill="none" stroke-linecap="round"></path>
    <g fill="#5c5c5a">
      <path
        d="M151 120c-3-38 19-56 49-56s52 20 49 56c-3-16-11-24-21-26-8-8-18-10-28-8-12-2-24 2-30 10-10 2-16 10-19 24Z"
      ></path>
      <path d="M164 92c4-26 28-36 46-30 18-4 34 10 28 30-8-12-20-16-32-14-16-4-32 2-42 14Z"></path>
      <path d="M151 110v24h6l1-26Zm98 0v24h-6l-1-26Z"></path>
    </g>
    <path d="M178 78q18-12 38-8m-28 16q16-8 36-4" stroke="#9b9b98" stroke-width="3" fill="none" stroke-linecap="round"></path>
  </g>

  <!-- Table -->
  <rect x="194" y="272" width="12" height="114" fill="var(--dev-furniture)"></rect>
  <ellipse cx="200" cy="388" rx="42" ry="7" fill="var(--dev-furniture)"></ellipse>
  <ellipse cx="200" cy="271" rx="130" ry="15" fill="var(--dev-table-rim)"></ellipse>
  <ellipse cx="200" cy="265" rx="130" ry="15" fill="var(--dev-table)"></ellipse>

  <!-- Plant -->
  <g class="dev-plant">
    <path d="M300 238c-8-10-10-20-5-28 7 6 9 16 5 28 5-10 12-15 20-15-2 9-10 14-20 15Z" fill="#3f8f5a"></path>
    <path d="M300 240c-4-8-12-11-19-10 2 7 9 10 19 10Z" fill="#5aa874"></path>
  </g>
  <path d="M289 240h22l-3 18h-16Z" fill="#ece9e1"></path>

  <!-- Laptop, seen from behind -->
  <rect x="144" y="258" width="108" height="7" rx="3.5" fill="#a9adb4"></rect>
  <path d="M150 262 156 206q1-6 7-6h70q6 0 7 6l6 56Z" fill="#c9ccd2"></path>
  <path class="dev-logo" d="m188 225-8 6 8 6m20-12 8 6-8 6m-6-16-8 20" stroke="var(--accent)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>

  <!-- Coffee arm -->
  <g class="dev-arm-sip">
    <path d="M246 204c16 10 20 32 16 46" stroke="#8f959c" stroke-width="22" stroke-linecap="round" fill="none"></path>
    <path d="M262 252c6-22 10-44 10-62" stroke="#f2c9a8" stroke-width="15" stroke-linecap="round" fill="none"></path>
    <g class="dev-mug">
      <g class="dev-steam" stroke="var(--muted)" stroke-width="2.5" fill="none" stroke-linecap="round">
        <path d="M248 152c-5-7 5-12 0-20-4-6 4-10 0-16"></path>
        <path d="M257 150c-5-7 5-12 0-20-4-6 4-10 0-16"></path>
        <path d="M266 152c-5-7 5-12 0-20-4-6 4-10 0-16"></path>
      </g>
      <path d="M269 168h4a8 8 0 0 1 0 16h-4" stroke="var(--accent)" stroke-width="5" fill="none"></path>
      <rect x="241" y="158" width="29" height="33" rx="5" fill="var(--accent)"></rect>
      <rect x="241" y="165" width="29" height="4" fill="#fff" opacity=".55"></rect>
    </g>
    <circle cx="274" cy="182" r="9" fill="#f2c9a8"></circle>
  </g>

  <!-- Ideas floating up -->
  <g class="dev-glyphs" fill="var(--muted)" font-family="var(--font-mono-stack)" font-size="16" font-weight="500">
    <text x="88" y="190">&lt;/&gt;</text>
    <text x="304" y="128">&#123; &#125;</text>
    <text x="104" y="110">;</text>
    <text x="318" y="208">=&gt;</text>
  </g>
</svg>

<style>
  .dev {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .dev :global(*) {
    transform-box: view-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dev-head {
      transform-origin: 200px 170px;
      animation: dev-head 6s ease-in-out infinite;
    }

    .dev-eyes ellipse {
      transform-box: fill-box;
      transform-origin: center;
      animation: dev-blink 4.2s infinite;
    }

    .dev-arm-type {
      animation: dev-type 0.28s ease-in-out infinite alternate;
    }

    .dev-arm-sip {
      transform-origin: 262px 252px;
      animation: dev-sip 5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    .dev-mug {
      transform-origin: 255px 190px;
      animation: dev-tilt 5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    .dev-steam path {
      stroke-dasharray: 44;
      animation: dev-steam 2.4s linear infinite;
    }

    .dev-steam path:nth-child(2) {
      animation-delay: -0.8s;
    }

    .dev-steam path:nth-child(3) {
      animation-delay: -1.6s;
    }

    .dev-leg--l {
      transform-origin: 172px 266px;
      animation: dev-swing 1.6s ease-in-out infinite alternate;
    }

    .dev-leg--r {
      transform-origin: 228px 266px;
      animation: dev-swing 1.6s ease-in-out -0.8s infinite alternate;
    }

    .dev-plant {
      transform-origin: 300px 240px;
      animation: dev-sway 3.5s ease-in-out infinite alternate;
    }

    .dev-logo {
      animation: dev-glow 1.8s ease-in-out infinite alternate;
    }

    .dev-glyphs text {
      opacity: 0;
      animation: dev-float 5s ease-out infinite;
    }

    .dev-glyphs text:nth-child(2) {
      animation-delay: 1.25s;
    }

    .dev-glyphs text:nth-child(3) {
      animation-delay: 2.5s;
    }

    .dev-glyphs text:nth-child(4) {
      animation-delay: 3.75s;
    }
  }

  @keyframes dev-head {
    0%,
    100% {
      transform: rotate(0);
    }
    30% {
      transform: rotate(-2.5deg);
    }
    60% {
      transform: rotate(1.5deg) translateY(1px);
    }
  }

  @keyframes dev-blink {
    0%,
    93%,
    100% {
      transform: scaleY(1);
    }
    96% {
      transform: scaleY(0.1);
    }
  }

  @keyframes dev-type {
    to {
      transform: translateY(-3px);
    }
  }

  @keyframes dev-sip {
    0%,
    40%,
    100% {
      transform: rotate(0);
    }
    55%,
    78% {
      transform: rotate(-11deg);
    }
  }

  @keyframes dev-tilt {
    0%,
    40%,
    100% {
      transform: rotate(0);
    }
    55%,
    78% {
      transform: rotate(-16deg);
    }
  }

  @keyframes dev-steam {
    from {
      stroke-dashoffset: 44;
      opacity: 0;
      transform: translateY(6px);
    }
    35% {
      opacity: 0.8;
    }
    to {
      stroke-dashoffset: -44;
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  @keyframes dev-swing {
    from {
      transform: rotate(-7deg);
    }
    to {
      transform: rotate(7deg);
    }
  }

  @keyframes dev-sway {
    from {
      transform: rotate(-5deg);
    }
    to {
      transform: rotate(5deg);
    }
  }

  @keyframes dev-glow {
    from {
      opacity: 0.45;
    }
  }

  @keyframes dev-float {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    20% {
      opacity: 0.9;
    }
    70% {
      opacity: 0;
      transform: translateY(-48px);
    }
    100% {
      opacity: 0;
      transform: translateY(-48px);
    }
  }
</style>
