---
import Arrow from './Arrow.astro';
import { projects } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pad = (n: number) => String(n).padStart(2, '0');
const host = (url: string) => new URL(url).host.replace(/^www\./, '');
---

<section id="work" class="section container lazy-render" style="--intrinsic-height:3200px" aria-labelledby="work-title">
  <header class="section-head">
    <p class="mono muted">(01)</p>
    <h2 id="work-title" class="section-title">{t('work.title')}</h2>
  </header>

  <ol class="projects">
    {
      projects.map((project, i) => (
        <li class="project reveal">
          <div class="project-meta mono muted">
            <span>{pad(i + 1)}</span>
            <span>{project.year}</span>
          </div>

          <div class="project-main">
            <h3 class="project-name">
              <a href={project.url} target="_blank" rel="noopener">
                {project.name}
                <Arrow />
                <span class="sr-only">({t('a11y.newTab')})</span>
              </a>
            </h3>
            <p class="project-summary">{project.summary[lang]}</p>

            <div class="project-body">
              <div>
                <h4 class="mono muted">{t('work.front')}</h4>
                <p>{project.front[lang]}</p>
                <a class="host link mono" href={project.url} target="_blank" rel="noopener" tabindex="-1">
                  {host(project.url)}
                </a>
              </div>
              <div>
                <h4 class="mono muted">
                  <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
                    <path d="M4 7V5a4 4 0 1 1 8 0v2h1v8H3V7h1Zm2 0h4V5a2 2 0 1 0-4 0v2Z" fill="currentColor" />
                  </svg>
                  {t('work.back')}
                </h4>
                <ul class="dash-list">
                  {project.back[lang].map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                {project.extraLinks?.map((extra) => (
                  <a class="host link mono" href={extra.url} target="_blank" rel="noopener">
                    {extra.label}
                    <span class="sr-only">({t('a11y.newTab')})</span>
                  </a>
                ))}
              </div>
            </div>

            <ul class="chips">
              {project.stack.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .projects {
    border-top: 1px solid var(--line);
  }

  .project {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  .project-meta {
    display: flex;
    gap: 1rem;
  }

  .project-main {
    display: grid;
    gap: 1rem;
  }

  .project-name {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .project-name a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s;
  }

  .project-name a:hover {
    color: var(--accent-ink);
  }

  .project-name a:hover :global(.arrow) {
    transform: translate(2px, -2px);
  }

  .project-summary {
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .project-body {
    display: grid;
    gap: 1.5rem;
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .project-body > div {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }

  .project-body h4 {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 400;
  }

  .host {
    justify-self: start;
    margin-top: 0.25rem;
    color: var(--fg);
    text-transform: none;
  }

  @media (min-width: 52rem) {
    .project {
      grid-template-columns: 12rem minmax(0, 1fr);
    }

    .project-meta {
      flex-direction: column;
      gap: 0.25rem;
      padding-top: 0.35rem;
    }

    .project-body {
      grid-template-columns: 1fr 1.25fr;
      gap: 2.5rem;
    }
  }
</style>
