---
import Arrow from './Arrow.astro';
import { projects } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pad = (n: number) => String(n).padStart(2, '0');
const host = (url: string) => new URL(url).host.replace(/^www\./, '');
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section id="work" class="section container lazy-render" style="--intrinsic-height:1100px" aria-labelledby="work-title">
  <header class="section-head">
    <p class="mono muted">(02)</p>
    <h2 id="work-title" class="section-title">{t('work.title')}</h2>
  </header>

  <!-- Tabs (WAI-ARIA pattern). Without JS every panel stays visible, one after the other. -->
  <div class="tabs reveal">
    <div class="tablist" role="tablist" aria-label={t('work.title')}>
      {
        projects.map((project, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`tab-${slug(project.name)}`}
            aria-controls={`panel-${slug(project.name)}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="mono muted">{pad(i + 1)}</span>
            {project.name}
          </button>
        ))
      }
    </div>

    {
      projects.map((project) => (
        <div
          class="panel"
          role="tabpanel"
          id={`panel-${slug(project.name)}`}
          aria-labelledby={`tab-${slug(project.name)}`}
          tabindex="0"
        >
          <div class="panel-head">
            <h3 class="project-summary">{project.summary[lang]}</h3>
            <div class="panel-meta">
              <a class="visit link" href={project.url} target="_blank" rel="noopener">
                {host(project.url)}
                <Arrow />
                <span class="sr-only">({t('a11y.newTab')})</span>
              </a>
              <span class="mono muted">{project.year}</span>
            </div>
          </div>

          <div class="project-body">
            <div>
              <h4 class="mono muted">{t('work.front')}</h4>
              <p>{project.front[lang]}</p>
            </div>
            <div>
              <h4 class="mono muted">
                <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
                  <path d="M4 7V5a4 4 0 1 1 8 0v2h1v8H3V7h1Zm2 0h4V5a2 2 0 1 0-4 0v2Z" fill="currentColor" />
                </svg>
                {t('work.back')}
              </h4>
              <ul class="dash-list">
                {project.back[lang].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>

          <ul class="chips">
            {project.stack.map((tech) => (
              <li class="chip">{tech}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#work [role="tab"]')];
  const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);

  const select = (index: number, focus = false) => {
    tabs.forEach((tab, i) => {
      const on = i === index;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
      panels[i].hidden = !on;
    });
    if (focus) tabs[index].focus();
  };

  if (tabs.length) {
    tabs[0].closest('.tabs')!.classList.add('is-ready');
    select(Math.max(0, tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true')));

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select(next, true);
      });
    });
  }
</script>

<style>
  .tablist {
    display: flex;
    gap: clamp(1.25rem, 4vw, 3rem);
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--line);
  }

  .tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.9rem;
    font-size: clamp(1.0625rem, 1.8vw, 1.375rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--muted);
    transition: color 0.25s;
  }

  .tab:hover,
  .tab[aria-selected='true'] {
    color: var(--fg);
  }

  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  .panel {
    display: grid;
    gap: 1.75rem;
    padding-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  .panel[hidden] {
    display: none;
  }

  /* Without JS all panels show: keep them apart. */
  .tabs:not(.is-ready) .panel + .panel {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
  }

  .panel:not([hidden]) {
    animation: panel-in 0.5s var(--ease-out);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .panel:focus-visible {
    outline-offset: 8px;
  }

  .panel-head {
    display: grid;
    gap: 1rem;
  }

  .project-summary {
    max-width: 38rem;
    font-size: clamp(1.1875rem, 2vw, 1.5rem);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .panel-meta {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
  }

  .visit:hover :global(.arrow) {
    transform: translate(2px, -2px);
  }

  .project-body {
    display: grid;
    gap: 1.5rem;
    color: var(--muted);
  }

  .project-body > div {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }

  .project-body h4 {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 400;
  }

  @media (min-width: 52rem) {
    .panel-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 3rem;
    }

    .panel-meta {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.35rem;
      padding-top: 0.4rem;
    }

    .project-body {
      grid-template-columns: 1fr 1.25fr;
      gap: 3rem;
    }
  }
</style>
